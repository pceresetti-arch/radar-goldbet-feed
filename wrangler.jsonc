{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radar-goldbet",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["ODSS_API_KEY", "BRIDGE_TOKEN"]
  }
}
