    "J1 League",
    "Saudi Pro League",
    "UEFA Champions League",
    "UEFA Europa League",
    "UEFA Conference League"
  ],
  "readiness": {
    "machine_state": "READY_DEEP_ANALYSIS",
    "standard_requires": [
      "fresh official FotMob standard XI",
      "tactical layer synchronized to XI fingerprint",
      "fresh GoldBet standard odds",
      "certified TRUE OPEN for all 1X2 and at least one FT Over"
    ],
    "player_props_block_standard_ready": false,
    "player_bet_requires_player_market_bet_ready": true,
    "player_props_operational_primary": "BetFlag/AAMS"
  },
  "official_xi": {
    "lineup_type": "standard",
    "confirmed": true,
    "complete_11v11": true,
    "allowed_status": ["SOURCE_CONFIRMED", "CROSS_CONFIRMED"],
    "forbidden_as_official": ["lastStarting11", "lastStartingLineups", "predicted", "probable", "expected"],
    "xi_fingerprint_required": true,
    "xi_change_invalidates_player_analysis": true
  },
  "market_policy": {
    "operational_bookmaker_standard": "GoldBet",
    "operational_source_player_props": "BetFlag/AAMS shared player service",
    "mms_primary_markets": ["1X2 FT", "OVER FT"],
    "strong_drop_absolute_decimal": 0.2,
    "strong_drop_requires_true_open": true,
    "first_seen_is_diagnostic_only": true,
    "final_gate_required": true,
    "bet_condition": "current_price >= FINAL_GATE",
    "player_props_policy": {
      "enabled": true,
      "role": "PRIMARY_OPERATIONAL_SOURCE",
      "activation": "use directly for every player-prop scan; do not wait for direct GoldBet player prices",
      "user_validation": "On 2026-08-25 the user confirmed the checked BetFlag/AAMS player-prop prices matched GoldBet exactly on the Saudi fixtures.",
      "rules": [
        "Use BetFlag/AAMS directly to scan and price all available player props: scorers, first-half/second-half scorers, first scorer, scorer-or-substitute/Plus, goals or assists, assists, shots, shots on target and other available player markets.",
        "Keep the actual source explicitly labelled BetFlag/AAMS and never relabel it as GoldBet direct.",
        "When recent calibration shows BetFlag/AAMS and GoldBet are substantially aligned, apply FINAL GATE directly to the BetFlag/AAMS price with no automatic proxy penalty.",
        "If calibration becomes stale or material drift is detected, apply a prudential buffer and flag the source-risk explicitly.",
        "If a fresh direct GoldBet player price is also available, use it as a cross-check; only a material same-selection divergence changes the operational acceptance price.",
        "Continue exact fixture, player, market, line and selection identity checks before classifying a BET."
      ]
    }
  },
  "player_context": {
    "lookback_matches_default": 6,
    "minutes_model": "PRELIMINARY_UNCALIBRATED",
    "features": [
      "starts",
      "appearances",
      "average_minutes_when_selected",
      "P60/P75/P90 preliminary",
      "historical_starting_position",
      "shot_origin",
      "shot_xG",
      "shots_on_target",
      "shot_situation_type",
      "opponent_concession_map"
    ],
    "heatmap": {
      "source": "FotMob location-density",
      "pitch": "105x68",
      "id_bridge": "matchDetails.content.playerStats.optaId -> FotMob player id",
      "features": ["centroid", "dispersion", "dominant_zone", "final_third_share", "box_share", "central_share"],
      "gps": false,
      "touch_by_touch": false,
      "optional": true,
      "standalone_edge_allowed": false
    }
  },
  "price_certification": {
    "goldbet_standard": "DIRECT_CERTIFIED_WHEN_FRESH_AND_MAPPED",
    "player_props": "BETFLAG_AAMS_PRIMARY_OPERATIONAL_USER_VALIDATED_AGAINST_GOLDBET_2026_08_25; SOURCE_LABEL_REQUIRED; GOLDBET_DIRECT_USED_AS_CALIBRATION_CROSSCHECK_WHEN_AVAILABLE"
  },
  "prospective_validation": {
